{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_digest",
    "description",
    "inputs",
    "output_path",
    "overwrite",
    "modify_path",
    "parameters",
    "as_of",
    "cache_hit",
    "execution_performed"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "recipe_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "description": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind",
          "identity"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "file",
              "directory"
            ]
          },
          "identity": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 5,
            "maxItems": 5
          }
        }
      }
    },
    "output_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "overwrite": {
      "type": "boolean"
    },
    "modify_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "as_of": {
      "type": "string"
    },
    "cache_hit": {
      "type": "boolean"
    },
    "execution_performed": {
      "type": "boolean",
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sheetbend-any:plan:1",
  "title": "Bound invocation preview, version 1"
}
