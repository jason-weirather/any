{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime",
    "description",
    "code",
    "inputs",
    "output",
    "parameters",
    "tests"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "runtime": {
      "const": "python-stdlib-v1"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "format",
          "required_columns"
        ],
        "properties": {
          "kind": {
            "enum": [
              "file",
              "directory"
            ]
          },
          "format": {
            "enum": [
              "csv",
              "tsv",
              "json",
              "text",
              "bytes",
              "directory"
            ]
          },
          "required_columns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "uniqueItems": true,
            "maxItems": 256
          }
        }
      },
      "maxItems": 32
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "required_columns"
      ],
      "properties": {
        "format": {
          "enum": [
            "csv",
            "tsv",
            "json",
            "text",
            "bytes"
          ]
        },
        "required_columns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 256
        }
      }
    },
    "parameters": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "default",
          "description"
        ],
        "properties": {
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "null"
            ]
          },
          "default": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "maxProperties": 32
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "files",
          "parameters",
          "expected_output"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "input_index",
                "path",
                "content"
              ],
              "properties": {
                "input_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                },
                "path": {
                  "type": "string",
                  "maxLength": 512
                },
                "content": {
                  "type": "string",
                  "maxLength": 8192
                },
                "modified_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 64,
                  "description": "Optional aware ISO timestamp; null/omitted uses the fixed fixture clock."
                }
              }
            },
            "maxItems": 32
          },
          "parameters": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "expected_output": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 32768
          }
        }
      },
      "minItems": 1,
      "maxItems": 4
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sheetbend-any:recipe:1",
  "title": "Executable recipe, version 1",
  "description": "Python code is untrusted even after validation or fixture tests. expected_output=null means an expected program failure. Fixture path is empty for a file input and relative for a directory input."
}
